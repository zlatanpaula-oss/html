<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgendaTech - Painel de Agendamentos</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b112c;
            background-image: radial-gradient(circle, #1a234d 10%, #0b112c 90%);
            min-height: 100vh;
            color: #ffffff;
            display: flex;
            flex-direction: column;
        }

        /* Topbar / Cabeçalho */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            background-color: rgba(11, 17, 44, 0.8);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }

        .brand-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-image {
            width: 50px;
            height: auto;
        }

        .brand-name {
            font-size: 24px;
            font-weight: bold;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-name {
            color: #8fa0dd;
            font-size: 14px;
            font-weight: 600;
        }

        .btn-sair {
            padding: 8px 16px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-sair:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: #ff4f4f;
            color: #ff4f4f;
        }

        /* Conteúdo Principal */
        main {
            flex: 1;
            padding: 40px;
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
        }

        .welcome-text {
            margin-bottom: 30px;
        }

        .welcome-text h1 {
            font-size: 28px;
            margin-bottom: 8px;
        }

        .welcome-text p {
            color: #8fa0dd;
            font-size: 16px;
        }

        /* Grid de Categorias */
        .grid-categorias {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
            margin-top: 20px;
        }

        /* Card de Item */
        .card-item {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 30px 20px;
            text-align: center;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            min-height: 220px;
        }

        .card-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(to right, #2575fc, #6a11cb);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .card-item:hover {
            transform: translateY(-5px);
            background-color: rgba(255, 255, 255, 0.08);
            border-color: #4facfe;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

        .card-item:hover::before {
            opacity: 1;
        }

        .card-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-grow: 1;
            justify-content: center;
            margin-bottom: 15px;
        }

        .card-icon {
            font-size: 40px;
            margin-bottom: 10px;
            display: inline-block;
        }

        .card-title {
            font-size: 20px;
            font-weight: 600;
        }

        .card-subtitle {
            font-size: 13px;
            color: #8fa0dd;
            margin-top: 5px;
        }

        /* Botão Acessar */
        .btn-acessar {
            width: 100%;
            padding: 10px 20px;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .card-item:hover .btn-acessar {
            background: linear-gradient(135deg, #2575fc 0%, #6a11cb 100%);
            border-color: transparent;
            box-shadow: 0 4px 15px rgba(37, 117, 252, 0.4);
        }
    </style>
</head>
<body>

    <header>
        <div class="brand-section">
            <div class="brand-name">AgendaTech</div>
        </div>
        <div class="user-profile">
            <span class="user-name">Olá, Usuário</span>
            <button class="btn-sair">Sair</button>
        </div>
    </header>

    <main>
        <div class="welcome-text">
            <h1>Seu Painel de Controle</h1>
            <p>Selecione uma das opções abaixo para gerenciar seus agendamentos e informações.</p>
        </div>

        <div class="grid-categorias">
            <!-- Card de Calendário de Provas -->
            <div class="card-item">
                <div class="card-content">
                    <span class="card-icon">📅</span>
                    <div class="card-title">Calendário de Provas</div>
                </div>
                <button class="btn-acessar">Acessar</button>
            </div>

            <!-- Card de Calendário de Avisos -->
            <div class="card-item">
                <div class="card-content">
                    <span class="card-icon">🔔</span>
                    <div class="card-title">Quadro de Avisos</div>
                </div>
                <button class="btn-acessar">Acessar</button>
            </div>

            <!-- Card de Itens Tecnológicos -->
            <div class="card-item">
                <div class="card-content">
                    <span class="card-icon">📱</span>
                    <div class="card-title">Itens Tecnológicos</div>
                </div>
                <button class="btn-acessar">Acessar</button>
            </div>

            <!-- Card de Laboratório TDS -->
            <div class="card-item">
                <div class="card-content">
                    <span class="card-icon">💻</span>
                    <div class="card-title">Laboratório TDS</div>
                </div>
                <button class="btn-acessar">Acessar</button>
            </div>

            <!-- Card de Ciências -->
            <div class="card-item">
                <div class="card-content">
                    <span class="card-icon">🔬</span>
                    <div class="card-title">Laboratório de Ciências</div>
                </div>
                <button class="btn-acessar">Acessar</button>
            </div>

            <!-- Card de Treinamentos de Segurança -->
            <div class="card-item">
                <div class="card-content">
                    <span class="card-icon">⚠️</span>
                    <div class="card-title">Treinamentos de Segurança</div>
                    <div class="card-subtitle">Tornado e Queimada</div>
                </div>
                <button class="btn-acessar">Acessar</button>
            </div>
        </div>
    </main>

</body>
</html>
