<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgendaTech - Painel de Agendamentos</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
  body { background-color: #0b112c; background-image: radial-gradient(circle, #1a234d 10%, #0b112c 90%); min-height: 100vh; color: #ffffff; display: flex; flex-direction: column; }
  
  /* Topbar / Cabeçalho */
  header { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 20px 40px; 
    background-color: rgba(11, 17, 44, 0.8); 
    border-bottom: 1px solid rgba(255, 255, 255, 0.1); 
    backdrop-filter: blur(10px); 
    position: relative;
  }
  .brand-section { display: flex; align-items: center; gap: 15px; }
  .brand-name { font-size: 24px; font-weight: bold; }
  
  /* Centralized Header Title */
  .center-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 22px;
    font-weight: bold;
    color: #4facfe;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .user-profile { display: flex; align-items: center; gap: 15px; }
  .user-name { color: #8fa0dd; font-size: 14px; font-weight: 600; }
  .btn-sair { padding: 8px 16px; background: transparent; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 20px; color: #ffffff; cursor: pointer; transition: all 0.3s; }
  .btn-sair:hover { background-color: rgba(255, 255, 255, 0.1); border-color: #ff4f4f; color: #ff4f4f; }
  
  /* Conteúdo Principal */
  main { flex: 1; padding: 40px; max-width: 1200px; width: 100%; margin: 0 auto; }
  .welcome-text { margin-bottom: 30px; }
  .welcome-text h1 { font-size: 28px; margin-bottom: 8px; }
  .welcome-text p { color: #8fa0dd; font-size: 16px; }

  /* Filtro de Turma */
  .filter-section { margin-bottom: 30px; display: flex; flex-direction: column; gap: 10px; max-width: 300px; }
  .filter-section label { font-size: 14px; color: #8fa0dd; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
  .select-turma { 
    padding: 12px; 
    background-color: rgba(255, 255, 255, 0.05); 
    border: 1px solid rgba(255, 255, 255, 0.2); 
    border-radius: 8px; 
    color: #ffffff; 
    font-size: 16px; 
    outline: none; 
    cursor: pointer;
    transition: border-color 0.3s;
  }
  .select-turma:focus { border-color: #4facfe; }
  .select-turma option { background-color: #0b112c; color: #ffffff; }

  /* Estilos da Grade de Horários e Botões */
  .agenda-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-top: 20px; }
  .agenda-card { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); padding: 20px; border-radius: 12px; backdrop-filter: blur(5px); text-align: center; }
  .agenda-card h3 { margin-bottom: 15px; color: #4facfe; }

  /* Botão Interativo */
  .btn-reservar { 
    width: 100%; 
    padding: 10px; 
    background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%); 
    border: none; 
    border-radius: 8px; 
    color: #0b112c; 
    font-weight: bold; 
    cursor: pointer; 
    transition: all 0.3s ease; 
  }
  .btn-reservar:hover { opacity: 0.9; transform: translateY(-2px); }
  
  /* Estado de Reservado */
  .btn-reservar.reservado { 
    background: #28a745; 
    color: #ffffff; 
    cursor: pointer; 
  }

  /* Identificação do Laboratório */
  .lab-footer {
    text-align: center;
    margin-top: 40px;
    font-size: 20px;
    font-weight: 600;
    color: #8fa0dd;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 20px;
  }
</style>
</head>
<body>

  <header>
    <div class="brand-section">
      <div class="brand-name">AgendaTech</div>
    </div>
    <div class="center-title">Painel de Agendamentos</div>
    <div class="user-profile">
      <span class="user-name">Olá, Usuário</span>
      <button class="btn-sair">Sair</button>
    </div>
  </header>

  <main>
    <div class="welcome-text">
      <h1>Bem-vindo ao seu painel</h1>
      <p>Selecione sua turma e escolha um horário abaixo para realizar a sua reserva.</p>
    </div>

    <!-- Opções de escolha das turmas -->
    <div class="filter-section">
      <label for="turma">Selecione a Turma:</label>
      <select id="turma" class="select-turma" onchange="atualizarPainelPorTurma()">
        <option value="6_ano">6º Ano - Fundamental</option>
        <option value="7_ano">7º Ano - Fundamental</option>
        <option value="8_ano">8º Ano - Fundamental</option>
        <option value="9_ano">9º Ano - Fundamental</option>
        <option value="1_medio">1º Ano - Ensino Médio</option>
        <option value="2_medio">2º Ano - Ensino Médio</option>
        <option value="3_medio">3º Ano - Ensino Médio</option>
      </select>
    </div>

    <!-- Cards gerados com os seus horários específicos -->
    <div class="agenda-grid">
      <div class="agenda-card">
        <h3>Horário: 7:30</h3>
        <button class="btn-reservar" data-horario="7:30" onclick="alternarReserva(this)">Reservar</button>
      </div>
      <div class="agenda-card">
        <h3>Horário: 8:15</h3>
        <button class="btn-reservar" data-horario="8:15" onclick="alternarReserva(this)">Reservar</button>
      </div>
      <div class="agenda-card">
        <h3>Horário: 9:05</h3>
        <button class="btn-reservar" data-horario="9:05" onclick="alternarReserva(this)">Reservar</button>
      </div>
      <div class="agenda-card">
        <h3>Horário: 10:05</h3>
        <button class="btn-reservar" data-horario="10:05" onclick="alternarReserva(this)">Reservar</button>
      </div>
      <div class="agenda-card">
        <h3>Horário: 11:45</h3>
        <button class="btn-reservar" data-horario="11:45" onclick="alternarReserva(this)">Reservar</button>
      </div>
    </div>

    <!-- Nome alterado embaixo dos cronogramas -->
    <div class="lab-footer">
      Laboratório Comum
    </div>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      atualizarPainelPorTurma();
    });

    function atualizarPainelPorTurma() {
      const turmaSelecionada = document.getElementById('turma').value;
      const botoes = document.querySelectorAll('.btn-reservar');
      
      botoes.forEach(botao => {
        const horarioReal = botao.getAttribute('data-horario');
        const chaveLocal = `reserva_${turmaSelecionada}_${horarioReal}`;
        
        if (localStorage.getItem(chaveLocal) === 'true') {
          botao.classList.add('reservado');
          botao.innerText = 'Reservado';
        } else {
          botao.classList.remove('reservado');
          botao.innerText = 'Reservar';
        }
      });
    }

    function alternarReserva(botao) {
      const turmaSelecionada = document.getElementById('turma').value;
      const horario = botao.getAttribute('data-horario');
      const chaveLocal = `reserva_${turmaSelecionada}_${horario}`;

      if (!botao.classList.contains('reservado')) {
        botao.classList.add('reservado');
        botao.innerText = 'Reservado';
        localStorage.setItem(chaveLocal, 'true');
      } else {
        botao.classList.remove('reservado');
        botao.innerText = 'Reservar';
        localStorage.removeItem(chaveLocal);
      }
    }
  </script>

</body>
</html>
